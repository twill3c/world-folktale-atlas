, “I can’t be everywhere at once.”\n\nAye! aye! that was a well-to-do household the wooer had come to.","cluster":20,"analysis":{"analysis_version":"1.0","embedding_model":"intfloat/multilingual-e5-small","themes":[],"motifs":[],"animals":[],"nature":[],"events":[{"position":0.0,"label":null,"hits":0,"lift":0.0,"method":"count"},{"position":0.091,"label":null,"hits":0,"lift":0.0,"method":"count"},{"position":0.182,"label":null,"hits":0,"lift":0.0,"method":"count"},{"position":0.273,"label":null,"hits":0,"lift":0.0,"method":"count"},{"position":0.364,"label":null,"hits":0,"lift":0.0,"method":"count"},{"position":0.455,"label":null,"hits":0,"lift":0.0,"method":"count"},{"position":0.545,"label":null,"hits":0,"lift":0.0,"method":"count"},{"position":0.636,"label":null,"hits":0,"lift":0.0,"method":"count"},{"position":0.727,"label":null,"hits":0,"lift":0.0,"method":"count"},{"position":0.818,"label":null,"hits":0,"lift":0.0,"method":"count"},{"position":0.909,"label":null,"hits":0,"lift":0.0,"method":"count"},{"position":1.0,"label":null,"hits":0,"lift":0.0,"method":"count"}],"tension":[{"position":0.0,"tension":0.0,"raw":0.0,"method":"lexicon"},{"position":0.091,"tension":0.0,"raw":0.0,"method":"lexicon"},{"position":0.182,"tension":0.0,"raw":0.0,"method":"lexicon"},{"position":0.273,"tension":0.0,"raw":0.0,"method":"lexicon"},{"position":0.364,"tension":0.0,"raw":0.0,"method":"lexicon"},{"position":0.455,"tension":0.0,"raw":0.0,"method":"lexicon"},{"position":0.545,"tension":0.0,"raw":0.0,"method":"lexicon"},{"position":0.636,"tension":0.0,"raw":0.0,"method":"lexicon"},{"position":0.727,"tension":0.0,"raw":0.0,"method":"lexicon"},{"position":0.818,"tension":0.0,"raw":0.0,"method":"lexicon"},{"position":0.909,"tension":0.0,"raw":0.0,"method":"lexicon"},{"position":1.0,"tension":0.0,"raw":0.0,"method":"lexicon"}],"characters":[]},"neighbors":[{"id":"GB-9368-022","title":"The Red Bandits of Montgomery","region":"ウェールズ","lang":"en","score":0.9142,"same_book":false},{"id":